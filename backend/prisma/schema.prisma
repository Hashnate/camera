generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OFFICE_ADMIN
  HR_MANAGER
  SUPERVISOR
  VIEWER
}

enum CameraStatus {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum CameraProviderType {
  EZVIZ
  HIKVISION
  DAHUA
  ONVIF_GENERIC
}

enum ZoneType {
  MAIN_OFFICE
  DEVELOPMENT
  MEETING_ROOM
  RECEPTION
  BREAK_AREA
  RESTRICTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_DEPARTURE
  HALF_DAY
  ABSENT
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         UserRole    @default(VIEWER)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  notifications Notification[]
  approvedCorrections AttendanceCorrection[] @relation("ApprovedBy")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  offices     Office[]
}

model Office {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  timezone    String       @default("UTC")
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  cameras     Camera[]
  zones       OfficeZone[]
  schedules   WorkSchedule[]
}

model Department {
  id          String       @id @default(uuid())
  officeId    String
  office      Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employees   Employee[]
}

model WorkSchedule {
  id           String      @id @default(uuid())
  officeId     String
  office       Office      @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name         String
  startTime    String      // "09:00"
  endTime      String      // "17:00"
  graceMinutes Int         @default(15)
  workingDays  String      @default("1,2,3,4,5") // Mon-Fri
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employees    Employee[]
}

model Employee {
  id                 String             @id @default(uuid())
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workScheduleId     String?
  workSchedule       WorkSchedule?      @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  employeeCode       String             @unique
  fullName           String
  email              String?
  jobTitle           String
  assignedZone       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attendanceRecords  AttendanceRecord[]
}

model Camera {
  id             String             @id @default(uuid())
  officeId       String
  office         Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name           String
  model          String
  serialNumber   String             @unique
  provider       CameraProviderType @default(EZVIZ)
  location       String?
  status         CameraStatus       @default(OFFLINE)
  lastOnlineAt   DateTime?
  firmwareVer    String?
  channels       CameraChannel[]
  events         CameraEvent[]
  detectionEvents DetectionEvent[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model CameraChannel {
  id           String      @id @default(uuid())
  cameraId     String
  camera       Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  channelNo    Int         @default(1)
  channelName  String
  hlsUrl       String?
  ezopenUrl    String?
  snapshotUrl  String?
  isEncrypted  Boolean     @default(false)
  status       Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([cameraId, channelNo])
}

model CameraEvent {
  id         String    @id @default(uuid())
  cameraId   String
  camera     Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  eventType  String    // CONNECTED, DISCONNECTED, ERROR
  message    String
  timestamp  DateTime  @default(now())
}

model OfficeZone {
  id               String            @id @default(uuid())
  officeId         String
  office           Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name             String
  type             ZoneType          @default(MAIN_OFFICE)
  capacity         Int               @default(10)
  polygonCoords    String?           // JSON string of [[x,y], ...]
  isRestricted     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  detectionEvents  DetectionEvent[]
  occupancyRecords OccupancyRecord[]
}

model DetectionEvent {
  id             String      @id @default(uuid())
  cameraId       String
  camera         Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           OfficeZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  channelNo      Int         @default(1)
  trackingId     Int?        // Anonymous tracking ID
  eventType      String      // PERSON_ENTER, PERSON_EXIT, OCCUPANCY_COUNT
  confidence     Float?
  personCount    Int         @default(1)
  timestamp      DateTime    @default(now())
}

model OccupancyRecord {
  id             String      @id @default(uuid())
  zoneId         String
  zone           OfficeZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  recordedAt     DateTime    @default(now())
  personCount    Int         @default(0)
  isOverCapacity Boolean     @default(false)
}

model AttendanceRecord {
  id                 String                 @id @default(uuid())
  employeeId         String
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date               String                 // "2026-11-13" (YYYY-MM-DD in office timezone)
  checkIn            DateTime?
  checkOut           DateTime?
  totalMinutes       Int                    @default(0)
  status             AttendanceStatus       @default(PRESENT)
  isLate             Boolean                @default(false)
  isEarlyDeparture   Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  corrections        AttendanceCorrection[]

  @@unique([employeeId, date])
}

model AttendanceCorrection {
  id                  String             @id @default(uuid())
  attendanceRecordId  String
  attendanceRecord    AttendanceRecord   @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedCheckIn    DateTime?
  requestedCheckOut   DateTime?
  reason              String
  status              CorrectionStatus   @default(PENDING)
  approvedById        String?
  approvedBy          User?              @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String    // INFO, WARNING, ALERT
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?   // JSON string
  ipAddress  String?
  createdAt  DateTime  @default(now())
}

